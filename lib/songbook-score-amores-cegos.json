    {
      "title": "Ponte",
      "lines": [
        {
          "text": "Moitos foron os amores"
        },
        {
          "text": "que xurdiron nesa vida,",
          "chords": [
            [
              0,
              "Am"
            ],
            [
              18,
              "A"
            ]
          ]
        },
        {
          "text": "tamén rotos polas dores,"
        },
        {
          "text": "agochados nos temores.",
          "chords": [
            [
              18,
              "E"
            ]
          ]
        },
        {
          "text": "Mais eu lembro a túa mirada,",
          "chords": [
            [
              5,
              "A"
            ]
          ]
        },
        {
          "text": "forte, ceibe, ben marcada,",
          "chords": [
            [
              7,
              "D"
            ],
            [
              23,
              "A"
            ]
          ]
        },
        {
          "text": "non te esquezas, onde esteas,"
        },
        {
          "text": "meu amor cego o levas.",
          "chords": [

  "sections": [
    {
      "title": "Estrofa 1",
      "lines": [
        {
          "text": "Foi fermosa aquela moza,",
          "chords": [
            [
              0,
              "Am"
            ]
          ]
        },
        {
          "text": "foi ben boa e mala prea,",
          "chords": [
            [
              8,
              "D"
            ],
            [
              19,
              "Am"
            ]
          ]
        },
        {
          "text": "agarimo sempre tiñas,"
        },
        {
          "text": "dos teus berros fuxo axiña.",
          "chords": [
            [
              9,
              "Bm"
            ],
            [
              22,
              "E"
            ]
          ]
        },
        {
          "text": "Cantando a razón levabas,",
          "chords": [
            [
              6,
              "A"
            ]
          ]
        },
        {
          "text": "outras veces esquivabas,",
          "chords": [
            [
              9,
              "D"
            ],
            [
              20,
              "A"
            ]
          ]
        },
        {
          "text": "mais sexas moza ou vella,"
        },
        {
          "text": "meu amor no peito albergas.",
          "chords": [
            [
              5,
              "Em"
            ],
            [
              12,
              "A"
            ]
          ]
        }
      ]
    },
    {
      "title": "Retrouso",
      "lines": [
        {
          "text": "Era unha moza ben nova",
          "chords": [
            [
              20,
              "D"
            ]
          ]
        },
        {
          "text": "cando a súa vida cambiou,",
          "chords": [
            [
              12,
              "A"
            ]
          ]
        },
        {
          "text": "pois dun día para outro",
          "chords": [
            [
              15,
              "E"
            ]
          ]
        },
        {
          "text": "mocidade alí quedou.",
          "chords": [
            [
              13,
              "A"
            ]
          ]
        },
        {
          "text": "Nunca lle deixou ao demo",
          "chords": [
            [
              17,
              "D"
            ]
          ]
        },
        {
          "text": "que o sorriso lle quitara,",
          "chords": [
            [
              21,
              "A"
            ]
          ]
        },
        {
          "text": "aprendeu pronto na vida",
          "chords": [
            [
              21,
              "E"
            ]
          ]
        },
        {
          "text": "que os amores se partillan.",
          "chords": [
            [
              23,
              "A"
            ]
          ]
        }
      ]
    },
    {
      "title": "Estrofa 2",
      "lines": [
        {
          "text": "Amor foi o dalgún día,"
        },
        {
          "text": "amor cego nas caricias,",
          "chords": [
            [
              7,
              "D"
            ],
            [
              18,
              "Am"
            ]
          ]
        },
        {
          "text": "pois o amor cego te lembra,"
        },
        {
          "text": "non te esquece polas beiras.",
          "chords": [
            [
              9,
              "Bm"
            ],
            [
              24,
              "Em"
            ]
          ]
        },
        {
          "text": "Amores que leva o tempo,",
          "chords": [
            [
              7,
              "A"
            ]
          ]
        },
        {
          "text": "outros duran un momento,",
          "chords": [
            [
              7,
              "D"
            ],
            [
              21,
              "A"
            ]
          ]
        },
        {
          "text": "mais sempre os amores cegos"
        },
        {
          "text": "non se esquecen, ben me lembro!",
          "chords": [
            [
              7,
              "E"
            ],
            [
              28,
              "A"
            ]
          ]
        }
      ]
    },
    {
      "title": "Estrofa 3",
      "lines": [
        {
          "text": "Son recordos, son lembranzas,"
        },
        {
          "text": "son sorrisos, son andanzas,",
          "chords": [
            [
              7,
              "D"
            ],
            [
              23,
              "A"
            ]
          ]
        },
        {
          "text": "amores cegos que tiña,"
        },
        {
          "text": "deses que cambian a vida.",
          "chords": [
            [
              6,
              "B"
            ],
            [
              22,
              "E"
            ]
          ]
        },
        {
          "text": "Pois aquela moza nova,",
          "chords": [
            [
              6,
              "Am"
            ]
          ]
        },
        {
          "text": "cando a vida lle mudou,",
          "chords": [
            [
              10,
              "D"
            ],
            [
              17,
              "A"
            ]
          ]
        },
        {
          "text": "atrás quedou unha nena"
        },
        {
          "text": "e outro amor nela medrou!",
          "chords": [
            [
              9,
              "Am"
            ],
            [
              13,
              "A"
            ]
          ]
        }
      ]
    },

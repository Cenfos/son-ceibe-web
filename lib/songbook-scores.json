  "amores-cegos": {"guide":[["Estrofas   ","A5 – D5 – A5 – E5",""],["Retrouso   ","A5 – E5 – A5 – D5",""],["Ponte / transición   ","E5 – A5 – D5 – E5",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"A5 – D5 – A5 – E5","kind":"sequence"},{"text":"Foi fermosa aquela moZa,"},{"text":"foi ben boa e mala prea,"},{"text":"agarimo sempre tiñas,"},{"text":"dos teus berros fuxo axiña."},{"text":"Cantando a razón levabas,"},{"text":"outras veces esquivabas,"},{"text":"mais sexas moza ou vella,"},{"text":"meu amor no peito albergas."}]},{"title":"Retrouso","lines":[{"text":"A5 – E5 – A5 – D5","kind":"sequence"},{"text":"Era unha moza ben nova"},{"text":"cando a súa vida cambiou,"},{"text":"pois dun día para outro"},{"text":"mocidade alí quedou."},{"text":"Nunca lle deixou ao demo"},{"text":"que o sorriso lle quitara,"},{"text":"aprendeu pronto na vida"},{"text":"que os amores se partillan."}]},{"title":"Estrofa 2","lines":[{"text":"A5 – D5 – A5 – E5","kind":"sequence"},{"text":"Amor foi o dalgún día,"},{"text":"amor cego nas caricias,"},{"text":"pois o amor cego te lembra,"},{"text":"non te esquece polas beiras."},{"text":"Amores que leva o tempo,"},{"text":"outros duran un momento,"},{"text":"mais sempre os amores cegos"},{"text":"non se esquecen, ben me lembro!"}]},{"title":"Estrofa 3","lines":[{"text":"A5 – D5 – A5 – E5","kind":"sequence"},{"text":"Son recordos, son lembranzas,"},{"text":"son sorrisos, son andanzas,"},{"text":"amores cegos que tiña,"},{"text":"deses que cambian a vida."},{"text":"Pois aquela moza nova,"},{"text":"cando a vida lle mudou,"},{"text":"atrás quedou unha nena"},{"text":"e outro amor nela medrou!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Ponte","lines":[{"text":"E5 – A5 – D5 – E5","kind":"sequence"},{"text":"Moitos foron os amores"},{"text":"que xurdiron nesa vida,"},{"text":"tamén rotos polas dores,"},{"text":"agochados nos temores."},{"text":"Mais eu lembro a túa mirada,"},{"text"
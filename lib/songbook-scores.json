  "as-duas-marias": {"guide":[["Estrofas   ","G – D – Em – Bm – C – G – Am – D",""],["Retrouso   ","G – D – Em – Bm – C – D – G",""],["Ponte / transición   ","Em – Bm – C – D",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"G – D – Em – Bm – C – G – Am – D","kind":"sequence"},{"text":"Dúas sombras pola rúa,"},{"text":"dous silencios ao pasar."},{"text":"Compostela bate a néboa,"},{"text":"e dous ollos para mirar."},{"text":"Foron Maruxa e Corália,"},{"text":"camiñando man a man."},{"text":"Levan fame, levan berros,"},{"text":"mais xuntas elas están."}]},{"title":"Estrofa 2","lines":[{"text":"G – D – Em – Bm – C – G – Am – D","kind":"sequence"},{"text":"Naceron nuns tempos malos,"},{"text":"décadas escuras son."},{"text":"Casa de xente rebelde,"},{"text":"moito iso non axudou."},{"text":"E chegou o mes de xullo,"},{"text":"e ese medo alí quedou."},{"text":"Moitos lles berraban “roxas”,"},{"text":"mais o seu sangue non dobrou."}]},{"title":"Pre-retrouso","lines":[{"text":"Em – Bm – C – D","kind":"sequence"},{"text":"E Compostela calaba,"},{"text":"as pedras sabían falar."},{"text":"Había portas ben pechadas"},{"text":"e ollos que non queren mirar."}]},{"title":"Retrouso","lines":[{"text":"G – D – Em – Bm – C – D – G","kind":"sequence"},{"text":"E alí van as dúas Marías"},{"text":"por Compostela andar."},{"text":"As flores levan no pelo,"},{"text":"mais o mundo queda atrás."},{"text":"Que ninguén borra os camiños,"},{"text":"nin as pegadas ao andar,"},{"text":"pois quen loita por ser Ceibe,"},{"text":"non se pode silenciar!"}]},{"title":"Despois do retrouso","lines":[{"text":"Em – Bm – C – D","kind":"sequence"},{"text":"As Marías, dúas mulleres,"},{"text":"dous corazóns contra o chan."},{"text":"Medo e morte percorrían,"},{"text":"foi loita por respirar."}]},{"title":"Estrofa 3","lines":[{"text":"G – D – Em – Bm – C – G – Am – D","kind":"sequence"},{"text":"Pero o tempo non esquece,"},{"text":"as pedras saben gardar"},{"text":"as historias dos que loitan,"},{"t
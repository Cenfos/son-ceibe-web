  "desta-terra-foi-a-voz": {"guide":[["Capo 3 · Soa en Mi bemol"],["Estrofas   ","C – G – C – G",""],["Retrouso   ","F – C – G – C",""],["Ponte / transición   ","F – C – F – G",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"C – G – C – G","kind":"sequence"},{"text":"Foi meniño de Rianxo,"},{"text":"foi emigrante no mar,"},{"text":"viu chorar os que marchaban"},{"text":"e os que quedaban sen pan."},{"text":"Quixo curar moitos corpos,"},{"text":"mais non podía mirar"},{"text":"as feridas dunha terra"},{"text":"que ninguén quería vendar."},{"text":"Cun lapis deu voz ao pobre"},{"text":"e ao mariñeiro do mar,"},{"text":"pois hai silencios tan grandes"},{"text":"que ata fan tremer o chan!"},{"text":"E cando a noite foi longa,"},{"text":"seica o botaron do lar;"},{"text":"coa súa terra na maleta,"},{"text":"non lla puideron quitar."}]},{"title":"Pre-retrouso","lines":[{"text":"F – C – F – G","kind":"sequence"},{"text":"Era noite xa en Rianxo,"},{"text":"cunha lúa de candil;"},{"text":"volveu baixando do barco:"},{"text":"a súa terra, o seu país!"}]},{"title":"Retrouso","lines":[{"text":"F – C – G – C","kind":"sequence"},{"text":"Nos debuxos daquel home"},{"text":"hai un pobo por erguer;"},{"text":"cada trazo fai semente,"},{"text":"nosa terra a florecer!"},{"text":"E se preguntades onde,"},{"text":"sen seu lapis esquecer,"},{"text":"el diría que ben xuntos:"},{"text":"xuntos, ceibes, sen ceder!"}]},{"title":"Estrofa 2","lines":[{"text":"C – G – C – G","kind":"sequence"},{"text":"Esta terra leva tempo"},{"text":"dando voltas sen chegar;"},{"text":"non lle faltan os camiños,"},{"text":"fáltalle botar a andar!"},{"text":"Viu os tractores na estrada,"},{"text":"viu aldeas feitas chan;"},{"text":"mozos coma os dalgún día,"},{"text":"cunha maleta na man!"},{"text":"Cambiaron barcos por voos,"},{"text":"a estación polo aeroporto;"},{"text":"chámanlle “facer carreira”"},{"text":"a emigrar por pouco ou moito!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 3","lines":[{"text":"C – G – C – G","kind":"sequence"},{"text":"Moita gravata ben posta,"},{"text":"moito coche oficial;"},{"text":"el sacou de novo o lapis:"},{"text":"¿e agora quen vai sachar?"},{"text":"Todos coñecen o rumbo,"},{"text":"todos saben gobernar;"},{"text":"el sacou de novo o lapis"},{"text":"e púxose a debuxar!"}]},{"title":"Ponte","lines":[{"text":"F – C – F – G","kind":"sequence"},{"text":"Se hoxe vivise entre nós,"},{"text":"non se había de retirar;"},{"text":"tería tinta nas mans,"},{"text":"mil viñetas pra pintar."},{"text":"Escribiría na rede,"},{"text":"mais tamén no campo e mar,"},{"text":"porque un “gústame” non chega"},{"text":"se non te ergues do sofá."},{"text":"E se o medo pecha portas,"},{"text":"coa retranca a traballar:"},{"text":"non hai cadeado tan forte;"},{"text":"pois coa risa, a enferruxar!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Continuación","lines":[{"text":"F – C – G – C","kind":"sequence"},{"text":"Xuntos, ceibes…... florecer!!!"}]}]},
  "a-esmorga-os-levou": {"guide":[["Capo 3"],["Estrofas e ponte   ","Em – C – G – D","   |   Retrouso   ","(C – G – D – Em) ×2",""],["Sen capo: estrofas e ponte   ","Gm – Eb – Bb – F","   |   Retrouso   ","(Eb – Bb – F – Gm) ×2",""],["Final   ","Em – C – G – D / G – D / C – D – Em",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"Era unha mañá calquera,","chords":[[0,"Em"]]},{"text":"día fresco a chuviscar,","chords":[[0,"C"]]},{"text":"un levaba sede de viño,","chords":[[0,"G"]]},{"text":"outro ganas de troulear.","chords":[[0,"D"]]},{"text":"Pola rúa cae choiva,","chords":[[0,"Em"]]},{"text":"nas tabernas fai calor,","chords":[[0,"C"]]},{"text":"un grolo pedía outro,","chords":[[0,"G"]]},{"text":"e outro grolo unha canción.","chords":[[0,"D"]]},{"text":"Ían mollados xa por fóra,","chords":[[0,"Em"]]},{"text":"por dentro ardía o licor,","chords":[[0,"C"]]},{"text":"e entre risas prometían:","chords":[[0,"G"]]},{"text":"que o tempo xa se parou!","chords":[[0,"D"]]}]},{"title":"Retrouso","lines":[{"text":"Pola rúa eles levaban","chords":[[0,"C"]]},{"text":"a esmorga de bar en bar,","chords":[[0,"G"]]},{"text":"mais logo foi esa esmorga","chords":[[0,"D"]]},{"text":"quen os levou sen parar!","chords":[[0,"Em"]]},{"text":"Escolleron o camiño,","chords":[[0,"C"]]},{"text":"ela escolleu onde acabar.","chords":[[0,"G"]]},{"text":"Eran tres cando empezaron...","chords":[[0,"D"]]},{"text":"moitos menos ó acabar!","chords":[[0,"Em"]]}]},{"title":"Estrofa 2","lines":[{"text":"E por esas rúas vellas,","chords":[[0,"Em"]]},{"text":"a noite púxose a andar,","chords":[[0,"C"]]},{"text":"As Burgas botaban fume,","chords":[[0,"G"]]},{"text":"eles non querían parar.","chords":[[0,"D"]]},{"text":"Unha porta, outra taberna,","chords":[[0,"Em"]]},{"text":"unha pelexa sen máis,","chords":[[0,"C"]]},{"text":"cada vez queda máis lonxe","chords":[[0,"G"]]},{"text":"o camiño a regresar!","chords":[[0,"D"]]},{"text":"E o que comezou con risas,","chords":[[0,"Em"]]},{"text":"entre viño e mocidade,","chords":[[0,"C"]]},{"text":"foise enchendo de silencios,","chords":[[0,"G"]]},{"text":"de xenreira, escuridade.","chords":[[0,"D"]]}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 3","lines":[{"text":"Nun furancho entre as sombras,","chords":[[0,"Em"]]},{"text":"unha dama viu chegar,","chords":[[0,"C"]]},{"text":"un deles perdeu a cabeza,","chords":[[0,"G"]]},{"text":"por quen non podía amar.","chords":[[0,"D"]]},{"text":"Xa non cantaban tan forte,","chords":[[0,"Em"]]},{"text":"xa custaba ata falar,","chords":[[0,"C"]]},{"text":"pero ningún dos tres homes","chords":[[0,"G"]]},{"text":"dixo: «Eu voume quedar».","chords":[[0,"D"]]},{"text":"Porque hai noites que te chaman,","chords":[[0,"Em"]]},{"text":"noites que saben mandar,","chords":[[0,"C"]]},{"text":"cando queres dar a volta....","chords":[[0,"G"]]},{"text":"xa non podes regresar!","chords":[[0,"D"]]}]},{"title":"Ponte","lines":[{"text":"Un levaba a tormenta,","chords":[[0,"Em"]]},{"text":"outro lume no ollar,","chords":[[0,"C"]]},{"text":"o terceiro seguía tras deles,","chords":[[0,"G"]]},{"text":"sen saber onde acabar.","chords":[[0,"D"]]},{"text":"Tres sombras baixo unha choiva,","chords":[[0,"Em"]]},{"text":"tres homes sen perdurar,","chords":[[0,"C"]]},{"text":"tres pasos cara a unha noite,","chords":[[0,"G"]]},{"text":"que era mellor non lembrar...","chords":[[0,"D"]]}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 4","lines":[{"text":"E cando chegou o sol,","chords":[[0,"Em"]]},{"text":"xa non quedaban cancións,","chords":[[0,"C"]]},{"text":"só a choiva polas pedras,","chords":[[0,"G"]]},{"text":"preguntas sen solucións!","chords":[[0,"D"]]},{"text":"Un quedou contando os feitos,","chords":[[0,"Em"]]},{"text":"outros non podían falar,","chords":[[0,"C"]]},{"text":"e as pedras aínda molladas,","chords":[[0,"G"]]},{"text":"coma se nada a pasar!","chords":[[0,"D"]]}]},{"title":"Retrouso final","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Final","lines":[{"text":"Tres saíron pola noite,","chords":[[0,"Em"]]},{"text":"tres beberon sen temor,","chords":[[0,"C"]]},{"text":"eles levaban a esmorga,","chords":[[0,"G"]]},{"text":"logo a esmorga os levou!","chords":[[0,"D"]]},{"text":"eles levaban a esmorga,","chords":[[0,"G"]]},{"text":"logo a esmorga os levou!","chords":[[0,"D"]]},{"text":"eles levaban a esmorga,","chords":[[0,"C"]]},{"text":"logo a esmorga os levou!","chords":[[0,"D"],[10,"Em"]]}]}]},
  "a-saber-o-que-ven": {"guide":[["Capo 4 · Soa en Mi bemol menor"],["Estrofas   ","Bm – G – D – A",""],["Retrouso   ","Bm – G – D – A",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"Bm – G – D – A","kind":"sequence"},{"text":"Era unha folla en branco,"},{"text":"diante dos teus ollos aberta,"},{"text":"sen saber o que che agarda,"},{"text":"nin onde a vida te leva."},{"text":"Aprendemos, pouco a pouco,"},{"text":"sen saber nin a lección,"},{"text":"pois dos erros ben se aprende,"},{"text":"non tes mellor ocasión!"},{"text":"Fabricamos as nosas vidas,"},{"text":"con detalle e antelación,"},{"text":"mais quen sabe onde se agocha,"},{"text":"a resposta e a solución?"}]},{"title":"Retrouso","lines":[{"text":"Bm – G – D – A","kind":"sequence"},{"text":"Fixa os teus ollos"},{"text":"nese horizonte,"},{"text":"fixa os teus soños"},{"text":"nos resplandores."},{"text":"Ficar esperto,"},{"text":"ficar contento,"},{"text":"fica a esperanza"},{"text":"no último alento!"}]},{"title":"Estrofa 2","lines":[{"text":"Bm – G – D – A","kind":"sequence"},{"text":"Hai renglóns que quedan tortos,"},{"text":"manchas que non has de borrar,"},{"text":"verbas que escribiu o tempo"},{"text":"que non podes pronunciar!"},{"text":"E se a vida muda o rumbo,"},{"text":"non teñas medo de andar,"},{"text":"pois tamén nas ramas rotas"},{"text":"hai historias que contar!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 3","lines":[{"text":"Bm – G – D – A","kind":"sequence"},{"text":"E mañá será outro soño,"},{"text":"outra historia pra cantar,"},{"text":"quizais veña cos acordes,"},{"text":"quizais toque improvisar!"},{"text":"Pois sempre cantando a vida,"},{"text":"contigo da miña man,"},{"text":"agarda a seguinte folla,"},{"text":"folla en branco, por chegar!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Continuación","lines":[{"text":"Bm – G – D – A","kind":"sequence"},{"text":"Non sabemos onde imos,"},{"text":"nin sabemos que virá,"},{"text":"mais temos todo o tempo"},{"text":"que nos queda por gastar."},{"text":"E mentres quede vida,"},{"text":"mentres quede un soño máis,"},{"text":"sempre haberá unha folla"},{"text":"que nos queda por encher."}]}]},
  "fios-de-amor": {"guide":[["Estrofas   ","G – D – Em – Em",""],["Retrouso   ","G – D – Em – Bm – C – G – Am – D",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Eran tempos todos eles"},{"text":"Nos que cun fío cosías"},{"text":"Un amor detrás de outro"},{"text":"Poucos intres persistían"}]},{"title":"Estrofa 2","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Ben sabías, ben sabías,"},{"text":"Sempre onde te metías"},{"text":"Pois ás veces coa mirada"},{"text":"Sen sabelo seducías!"}]},{"title":"Estrofa 3","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Noites eran, lúa chea,"},{"text":"Mais estrelas non cabían"},{"text":"E de pronto percatabas,"},{"text":"Coma a alma transformabas!"}]},{"title":"Estrofa 4","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Non podías, non debías,"},{"text":"Facer tantas tolerías,"},{"text":"Foron noites de xuntanzas"},{"text":"Quen puidera noutras vidas!"}]},{"title":"Retrouso","lines":[{"text":"G – D – Em – Bm – C – G – Am – D","kind":"sequence"},{"text":"Fíos de amor, fíos de vida,"},{"text":"fíos que veñen, fíos que van,"},{"text":"fíos que un día se tecían,"},{"text":"e pouco a pouco se desfán."}]},{"title":"Estrofa 5","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Eran mozas todas Elas"},{"text":"Que na Esmorga acontecían"},{"text":"Pois tan só cun fío de la"},{"text":"Un bico faise notar!"}]},{"title":"Estrofa 6","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Ten coidado polas noites"},{"text":"Non os vaias perder"},{"text":"Pois os amores de fío"},{"text":"Uns intres os vas a ter!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 7","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Quedan fíos de lembranzas"},{"text":"Que só de Noite pasaron"},{"text":"Ti contabas e contabas"},{"text":"Os fíos de amor que levabas!"}]},{"title":"Estrofa 8","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Fíos de amor duns minutos"},{"text":"Outros apenas segundos"},{"text":"Mais a troula regresaba"},{"text":"Cando menos o esperabas!"}]},{"title":"Estrofa 9","lines":[{"text":"G – D – Em – Em","kind":"sequence"},{"text":"Fíos de amor dalgún día"},{"text":"Que ao ver as súas puntadas"},{"text":"Nese intre xa sabías"},{"text":"Que aquilo xa rematara!!!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]}]},
  "amor-dun-neno": {"guide":[["Estrofas   ","Am – F – C – C",""],["Retrouso   ","Dm – F – C – C",""],["Ponte / transición   ","Am – F – C",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"Am – F – C – C","kind":"sequence"},{"text":"Era un neno ben cativo,"},{"text":"fai pouco nin era vivo,"},{"text":"nin dez anos el tería,"},{"text":"mais o amor xa coñecía."},{"text":"El miraba e miraba,"},{"text":"ás rapazas escoitaba."},{"text":"Sempre algunha lle molaba,"},{"text":"mais a vergonza gañaba."},{"text":"Foron amores dun tempo,"},{"text":"lembranzas daquel momento,"},{"text":"pois na vida hai amores,"},{"text":"físicos e doutras cores."}]},{"title":"Retrouso","lines":[{"text":"Dm – F – C – C","kind":"sequence"},{"text":"Amor dun neno, de home pequeno,"},{"text":"amor dun día, amores cegos,"},{"text":"porque aínda hai cores que fan amores,"},{"text":"outros quedaron, tal vez mellores."}]},{"title":"Estrofa 2","lines":[{"text":"Am – F – C – C","kind":"sequence"},{"text":"Era un mozo xa ben feito,"},{"text":"levaba amores por dentro,"},{"text":"mais a troula inda gañaba,"},{"text":"e ese amor non o atopaba."},{"text":"Amores son dos cativos,"},{"text":"tamén dos tempos perdidos,"},{"text":"amores que quedan soltos,"},{"text":"tal vez se vaian con outros."},{"text":"Amores da miña terra,"},{"text":"miña casa, miña leira,"},{"text":"amores son da familia,"},{"text":"eses non cambian na vida."}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 3","lines":[{"text":"Am – F – C – C","kind":"sequence"},{"text":"Amores que agochan as festas,"},{"text":"outras veces son nas leiras,"},{"text":"moitos amores quedaron,"},{"text":"na vida non afincaron."},{"text":"E se un día xa estás farto"},{"text":"do que foi un parvo amor,"},{"text":"lembra sempre aqueles anos,"},{"text":"fai só ese favor."},{"text":"Pois aquel neno cativo,"},{"text":"por moito el xa pasou,"},{"text":"é todo aquilo que sabe,"},{"text":"da experiencia que tomou."}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Final","lines":[{"text":"Am – F – C – C","kind":"sequence"},{"text":"Mais non perdas o sorriso"},{"text":"daquel cativo pequeno,"},{"text":"pois o amor está agardando,"},{"text":"e iso sábeo ata o demo!!!"}]}]},
  "me-estan-a-fartar": {"guide":[["Estrofas   ","Am – C – G – Am",""],["Retrouso   ","Am – C – D – Am",""],["Ponte / transición   ","C – D – F – Am",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Ficas esperto, busca o teu soño,"},{"text":"Ti saes correndo, xa non tes dono,"},{"text":"Mais todo aquilo que ás veces pensas,"},{"text":"Ti xa vas fartoooo, busca o teu soño!!!"}]},{"title":"Estrofa 2","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Eran ditaduras de xente de mal,"},{"text":"Eles só pensaban no seu benestar,"},{"text":"Mais a súa xente mal o está a pasar,"},{"text":"E ninguén se lembra de quen queda atrás!"}]},{"title":"Retrouso","lines":[{"text":"Am – C – D – Am","kind":"sequence"},{"text":"Mais coma galego póñome a pensar,"},{"text":"Qué querés que che digaaa...!!!"},{"text":"Me están a fartar!!!"},{"text":"Me están a fartar!!!"},{"text":"Me están a fartar!!!!"}]},{"title":"Estrofa 3","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Moitos eran homes, mulleres e nenos,"},{"text":"Trataron a moitos peor ca a cadelos,"},{"text":"Moitos murmuraron co medo no corpo,"},{"text":"E ninguén pensando no medo dos outros."}]},{"title":"Estrofa 4","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Século vinteún, dicían que andamos,"},{"text":"Mais ás veces penso que alí nos quedamos,"},{"text":"Naquelas cavernas algún aínda queda,"},{"text":"Mudaron as formas, pero a merda é a mesma."}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 5","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Galicia foi terra de ir e voltar,"},{"text":"De barcos cargados buscando outro lar,"},{"text":"Hoxe son outros que veñen e van,"},{"text":"Veñen coa esperanza, poder prosperar."}]},{"title":"Estrofa 6","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Que ninguén decida quen ten que vivir,"},{"text":"Que ninguén escolla o seu porvir,"},{"text":"Non sei que lle pasa á nosa humanidade..."},{"text":"Cada día máis fartoooo da desigualdade!!!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 7","lines":[{"text":"Am – C – G – Am","kind":"sequence"},{"text":"Non quero un mundo de ricos e pobres,"},{"text":"Nin portas pechadas, nin muros enormes,"},{"text":"EU quero que a xente poida decidir,"},{"text":"Onde medra, onde marcha... e onde quere vivir!!!!"}]},{"title":"Retrouso final","lines":[{"text":"Am – C – D – Am","kind":"sequence"},{"text":"Mais coma galego póñome a pensar,"},{"text":"Qué querés que che digaaa...!!!"},{"text":"Me están a fartar!!!"},{"text":"Me están a fartar!!!"},{"text":"Me están a fartaaaaaar!!!!"}]}]},
  "mais-ti-non-o-queres-ver": {"guide":[["Estrofas   ","G – D – C – D",""],["Retrouso   ","G – D – Am – C – D",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"El era un home ben rudo,"},{"text":"El era un home ben feito,"},{"text":"Mais por dentro ten a loita,"},{"text":"Loita e puro sentimento!"},{"text":"Pois foi un home da Noite,"},{"text":"Foi un home do seu tempo,"},{"text":"Mellor non o amoles moito,"},{"text":"Non quererás saír correndo!"}]},{"title":"Retrouso","lines":[{"text":"G – D – Am – C – D","kind":"sequence"},{"text":"Aprendemos xa ben cedo"},{"text":"A cubrirnos ben por fóra,"},{"text":"Cos dous puños levantados,"},{"text":"Cóbados gardan as costas!"},{"text":"Cada quen ten os seus demos,"},{"text":"Cada quen ten que aprender,"},{"text":"Que o camiño está diante,"},{"text":"Mais ti non o queres ver!"}]},{"title":"Estrofa 2","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"Cousas que pasan na vida,"},{"text":"Por algún motivo foi,"},{"text":"Non te esquezas do pasado,"},{"text":"O presente xa pasou!"},{"text":"Comeza sempre por dentro,"},{"text":"Ergue forte o teu peito,"},{"text":"Podes comezar de cero,"},{"text":"Nun futuro que é incerto!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 3","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"Non esquezas esas verbas"},{"text":"Que che dixeron un día,"},{"text":"Foron verbas de amizade,"},{"text":"Outras moitas da familia!"},{"text":"Pois se nun furado agochas"},{"text":"A túa alma, a túa vida,"},{"text":"Sempre podes saír máis forte,"},{"text":"Mudando a pel e a vida!"}]},{"title":"Retrouso final","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]}]},
  "onde-o-ceo-bica-o-mar": {"guide":[["Estrofas   ","Em – G – D – Em",""],["Retrouso   ","Em – G – D – C – B – Em",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"E nunha Praia da aldea,"},{"text":"Na que o mar sempre mandaba,"},{"text":"Ten cuidado coa marea,"},{"text":"Que se baixa vas con ela..."},{"text":"Moita area percorría,"},{"text":"Todo o chan que alí ficaba,"},{"text":"Cuncas de moitos cangrexos,"},{"text":"Polo Chan xa atopabas"}]},{"title":"Retrouso","lines":[{"text":"Em – G – D – C – B – Em","kind":"sequence"},{"text":"Onde o ceo bica o mar,"},{"text":"Onde o ceo bica o mar,"},{"text":"Alí onde o sol se agocha,"},{"text":"Na beira, na beira do mar!"},{"text":"Sube e baixa a marea"},{"text":"Sube e baixa sen parar,"},{"text":"Pois cando a lúa está ben chea,"},{"text":"Preto e lonxe queda o mar!!!"}]},{"title":"Estrofa 2","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"Moitas dunas perduraban"},{"text":"Pois a marea non chegaba"},{"text":"Por alí se albiscaban"},{"text":"As parellas namoradas!"},{"text":"Calas, recunchos de area,"},{"text":"Xa nas rochas atopabas,"},{"text":"Pois cando baixa a marea,"},{"text":"Moitos ollos, que miradas!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 3","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"Rochas fíos coma dentes"},{"text":"Outras menos afiladas"},{"text":"Pois o mar as veces talla"},{"text":"E a rocha faise almofada"},{"text":"Contra as olas te tirabas"},{"text":"Mais o mar te regresaba,"},{"text":"Ten cuidado coas correntes,"},{"text":"Non esquezas onde estabas!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 4","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"Praias valeiras de xente,"},{"text":"A ben poucos atopabas"},{"text":"E cando o sol adormece"},{"text":"No horizonte tes a calma..."},{"text":"Praias de verán e inverno,"},{"text":"Sempre a calma atopabas"},{"text":"Non fai falta ir a buscalas"},{"text":"Pois todas están na patria!!!"}]}]},
  "a-catro-patas": {"guide":[["Estrofas   ","G – D – C – D",""],["Retrouso   ","Em – Bm – C – D",""],["Ponte / transición   ","G – Em – C – D – G",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"As estrelas dunha noite,"},{"text":"lúa crecente, asomaban."},{"text":"Ao carón da beira da rúa"},{"text":"cando xa ías pra casa."}]},{"title":"Estrofa 2","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"Todo feito xa quedaba."},{"text":"Ben aquel día te portaras,"},{"text":"ti voltabas xa pra casa,"},{"text":"pois o día rematára!"}]},{"title":"Estrofa 3","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"Mais ás túas costas soaba"},{"text":"unha voz que che lembraba:"},{"text":"\"Aínda é cedo pra ir pra casa,"},{"text":"toma unha e logo marchas.\""}]},{"title":"Retrouso","lines":[{"text":"Em – Bm – C – D","kind":"sequence"},{"text":"E nesa noite aprendín"},{"text":"que aínda os días non rematan,"},{"text":"que aínda albergan toda a noite,"},{"text":"hai que andar a catro patas."},{"text":"Noite de lume que agochan"},{"text":"praceres e moita troula."},{"text":"Ten coidado, non te afogues,"},{"text":"pois o día xa te escoita."}]},{"title":"Estrofa 4","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"Pois cando un amigo chama,"},{"text":"non te quedes xa coas ganas,"},{"text":"pois nun intre pasa a vida,"},{"text":"é mellor ceibe vivila."}]},{"title":"Estrofa 5","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"En aquel día fuximos"},{"text":"das penurias dos rencores,"},{"text":"dos fracasos, dos amores"},{"text":"que aínda están por vir mellores."}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 6","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"E brindamos sen sentido,"},{"text":"xuntos todos entre amigos,"},{"text":"xuntanzas sen ter motivo,"},{"text":"algo queda ben vivido!"}]},{"title":"Final","lines":[{"text":"G – D – C – D","kind":"sequence"},{"text":"E se pasaches as noites"},{"text":"de lume, esmorga,  azar,"},{"text":"mil oitocentos oitenta,"},{"text":"esa noite vas lembrar."}]}]},
  "aqui-que-non-quede-nada": {"guide":[["Estrofas   ","Em – G – D – Em",""],["Retrouso   ","Em – D – C – D",""],["Ponte / transición   ","Em – C – G – D",""]],"sections":[{"title":"Estrofa 1","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"Nunha taberna que fomos,"},{"text":"nunha bodega de viño,"},{"text":"onde sempre alí poñían"},{"text":"tapa e cunca de albariño!"},{"text":"Non pasabas por diante"},{"text":"sen cheirar o fondo aquilo,"},{"text":"pois sempre o lume andaba,"},{"text":"ben baixiño, ben baixiño."}]},{"title":"Estrofa 2","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"Moitos berros atopabas,"},{"text":"tamén risas no camiño,"},{"text":"mais alí sempre voltamos,"},{"text":"cousas raras do destino!"},{"text":"Moitos berros se escoitaban,"},{"text":"tamén risas, coma fíos,"},{"text":"mais alí sempre tornabas,"},{"text":"pois querías tapa e viño!"}]},{"title":"Retrouso","lines":[{"text":"Em – D – C – D","kind":"sequence"},{"text":"Ben xantabas, ben cenabas,"},{"text":"cunha morea de tapas,"},{"text":"e de paso xa levabas"},{"text":"chispa, esmorga ben marcada!"},{"text":"Máis valía, máis valía,"},{"text":"que as tapas non as deixaras,"},{"text":"pois a cociñeira dixo:"},{"text":"«Aquí que non quede nada!»"}]},{"title":"Estrofa 3","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"E así fomos visitando,"},{"text":"os furanchos de algún día,"},{"text":"o viño ía correndo,"},{"text":"e a min nada me doía."},{"text":"Nese intre xa pensamos:"},{"text":"«Que coas tapas xa ceamos!»"},{"text":"Cada brinde acontecía"},{"text":"sen motivo, quen sabía!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Estrofa 4","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"Ben papamos, ben papamos,"},{"text":"toda a tarde merendamos,"},{"text":"mais cando chegou a cea,"},{"text":"daquela non perdoamos."},{"text":"E xa coa mente da noite,"},{"text":"fartos de churrasco e viño,"},{"text":"tocoulle chupito e postre,"},{"text":"non me lembro ben daquilo!!!!"}]},{"title":"Pre-retrouso","lines":[{"text":"Em – C – G – D","kind":"sequence"},{"text":"Nin me esquezo, nin me lembro,"},{"text":"como non lembrar, se aquilo pasou!"},{"text":"Se o amencer nos atopou,"},{"text":"e algún de nós nin se enterou!"}]},{"title":"Retrouso","lines":[{"text":"Repite o retrouso completo.","kind":"repeat"}]},{"title":"Final","lines":[{"text":"Em – G – D – Em","kind":"sequence"},{"text":"De tapas fomos,"},{"text":"de tapas volvemos..."},{"text":"do que pasou polo medio,"},{"text":"algo lembro, algo esquezo..."},{"text":"tapa e viño, tapa e viño,"},{"text":"mais se alí aínda quedaba,"},{"text":"mañán xa repetiremos!"},{"text":"Alí que non quede nada!!!"}]}]}
}

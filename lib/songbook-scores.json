  "a-mina-terra-chama": {"guide":[["Intro, estrofas e foliada   ","G – D – Em – C",""],["Pre-ret. e ponte II   ","Am – Bm – C – D","   |   Retrouso   ","(G–D / Em–C) ×3",""],["Ponte suave   ","(Em–Bm / C–D) ×2","   |   Peche   ","D – G – D – Em – C – G",""]],"sections":[{"title":"Intro","lines":[{"text":"G - D - Em - C (x2)","kind":"sequence"},{"text":"Ay-ai-ai! Ay-ai-ai!"}]},{"title":"Estrofa 1","lines":[{"text":"Saímos catro da casa,","chords":[[0,"G"]]},{"text":"unha mochila e ilusión,","chords":[[0,"D"]]},{"text":"Galicia no retrovisor,","chords":[[0,"Em"]]},{"text":"Londres no corazón.","chords":[[0,"C"]]},{"text":"Avión arriba, nubes fóra,","chords":[[0,"G"]]},{"text":"mans ben apertadas,","chords":[[0,"D"]]},{"text":"comeza a aventura","chords":[[0,"Em"]]},{"text":"que a familia agardaba...","chords":[[0,"C"]]}]},{"title":"Estrofa 2","lines":[{"text":"Londres é un trebón de luces,","chords":[[0,"G"]]},{"text":"de linguas e de cor,","chords":[[0,"D"]]},{"text":"do Big Ben ao Támesis,","chords":[[0,"Em"]]},{"text":"todo é un rumor.","chords":[[0,"C"]]},{"text":"Metro que vai e que vén,","chords":[[0,"G"]]},{"text":"nós perdidos e rindo,","chords":[[0,"D"]]},{"text":"que bonito é","chords":[[0,"Em"]]},{"text":"perderse se é contigo!","chords":[[0,"C"]]}]},{"title":"Pre-retrouso","lines":[{"text":"Levo as vosas risas","chords":[[0,"Am"]]},{"text":"gardadas no peto,","chords":[[0,"Bm"]]},{"text":"cada foto, cada paso,","chords":[[0,"C"]]},{"text":"cada conto feito.","chords":[[0,"D"]]},{"text":"Pois o mundo é máis fermoso","chords":[[0,"Am"]]},{"text":"si o vexo convosco,","chords":[[0,"Bm"]]},{"text":"sodes o meu mapa,","chords":[[0,"C"]]},{"text":"o meu norte e o meu todo!","chords":[[0,"D"]]}]},{"title":"Retrouso","lines":[{"text":"E Londres brilla, si, pero a miña terra chama!","chords":[[0,"G"],[15,"D"]]},{"text":"Brilla Londres, pero o lar é chama!","chords":[[0,"Em"],[15,"C"]]},{"text":"Mil lembranzas novas que nunca se apagan,","chords":[[0,"G"],[15,"D"]]}